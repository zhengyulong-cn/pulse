// use prisma-next

enum TradeDirection {
  LONG
  SHORT
}

model TradingAccount {
  id           Int           @id @default(autoincrement())
  name         String
  account      String        @unique
  currency     String
  tradeRecords TradeRecord[]
}

model TradingExchange {
  id          Int      @id @default(autoincrement())
  name        String
  englishName String
  mic         String   @unique
  countryCode String
  city        String
  timezone    String
  currency    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model TradeRecord {
  id             Int            @id @default(autoincrement())
  accountId      Int
  underlyingName String
  underlyingCode String
  direction      TradeDirection
  quantity       Decimal
  openTime       DateTime
  openPrice      Decimal
  closeTime      DateTime?
  closePrice     Decimal?
  realizedPnl    Decimal?
  fee            Decimal
  extraJson      Json?
  account        TradingAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([openTime])
}
