// use prisma-next

enum TradeDirection {
  LONG
  SHORT
}

enum PineScriptType {
  INDICATOR
  STRATEGY
}

enum FutureTrendDirection {
  UP
  DOWN
}

enum FutureTrendSegmentType {
  TREND_IMPULSE
  TREND_PULLBACK
  RANGE_INTERNAL
}

enum FutureTrendLifecycle {
  DECAY
  GROWTH
  STRONG
}

model TradingAccount {
  id           Int           @id @default(autoincrement())
  name         String
  account      String        @unique
  currency     String
  tradeRecords TradeRecord[]
}

model TradeRecord {
  id             Int            @id @default(autoincrement())
  accountId      Int
  underlyingName String
  underlyingCode String
  direction      TradeDirection
  quantity       Decimal
  openTime       DateTime
  openPrice      Decimal
  openReason     String?
  screenshots    Json?
  reflection     String?
  tags           String[]      @default([])
  closeTime      DateTime?
  closePrice     Decimal?
  closeReason    String?
  realizedPnl    Decimal?
  fee            Decimal
  account        TradingAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([openTime])
}

model Watchlist {
  id        Int             @id @default(autoincrement())
  name      String
  sortOrder Int             @default(0)
  items     WatchlistItem[]

  @@index([sortOrder])
}

model WatchlistItem {
  id          Int       @id @default(autoincrement())
  watchlistId Int
  instrumentId Int
  sortOrder   Int       @default(0)
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id])

  @@unique([watchlistId, instrumentId])
  @@index([watchlistId, sortOrder])
}

model PineScript {
  id          Int            @id @default(autoincrement())
  content     String
  description String
  type        PineScriptType
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now())

  @@index([type])
}

model FutureTrendStatusSnapshot {
  id                   Int                    @id @default(autoincrement())
  snapshotKey          String
  snapshotAt           DateTime
  contract             String
  trend3hDirection     FutureTrendDirection?
  trend3hSegmentType   FutureTrendSegmentType?
  trend3hLifecycle     FutureTrendLifecycle?
  trend30fDirection    FutureTrendDirection?
  trend30fSegmentType  FutureTrendSegmentType?
  trend30fLifecycle    FutureTrendLifecycle?

  @@unique([snapshotKey, contract])
  @@index([snapshotAt])
  @@index([snapshotKey])
  @@index([contract, snapshotAt])
}
