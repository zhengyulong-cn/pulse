// use prisma-next

enum TradeDirection {
  LONG
  SHORT
}

enum PineScriptType {
  INDICATOR
  STRATEGY
}

model TradingAccount {
  id           Int           @id @default(autoincrement())
  name         String
  account      String        @unique
  currency     String
  tradeRecords TradeRecord[]
}

model TradeRecord {
  id             Int            @id @default(autoincrement())
  accountId      Int
  underlyingName String
  underlyingCode String
  direction      TradeDirection
  quantity       Decimal
  openTime       DateTime
  openPrice      Decimal
  closeTime      DateTime?
  closePrice     Decimal?
  realizedPnl    Decimal?
  fee            Decimal
  extraJson      Json?
  account        TradingAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([openTime])
}

model Watchlist {
  id        Int             @id @default(autoincrement())
  name      String
  sortOrder Int             @default(0)
  items     WatchlistItem[]

  @@index([sortOrder])
}

model WatchlistItem {
  id          Int       @id @default(autoincrement())
  watchlistId Int
  instrumentId Int
  sortOrder   Int       @default(0)
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id])

  @@unique([watchlistId, instrumentId])
  @@index([watchlistId, sortOrder])
}

model PineScript {
  id          Int            @id @default(autoincrement())
  content     String
  description String
  type        PineScriptType
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now())

  @@index([type])
}
