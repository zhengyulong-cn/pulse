{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @pulse/web run dev",
    "dev:server": "pnpm --filter @pulse/server run dev",
    "dev:data-center": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location -LiteralPath 'packages/pulse-data-center'; & '.\\.venv\\Scripts\\python.exe' -m fastapi dev main.py\"",
    "contract:emit": "pnpm --filter @pulse/server run contract:emit",
    "db:update": "pnpm --filter @pulse/server run db:update"
  }
}
